# Copy to .env and fill in. .env is gitignored.

# Gemini is called only after an operator approves sending an incident report.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REPORT_TIMEOUT_S=30

# SMTP: Gmail requires an app password (not your normal account password).
# No email is sent automatically. Every email and PDF is labelled as a synthetic exercise.
ALERT_RECIPIENT=daeyad1@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Ports used by ./dev.sh
BACKEND_PORT=8000
FRONTEND_PORT=5173

# SQLite database file (created at runtime)
DB_PATH=backend/biosecurity.sqlite3

# Simulation
SIM_SEED=42
SIM_START_DATE=2026-09-01
CLOCK_SECONDS_PER_DAY=2.0
