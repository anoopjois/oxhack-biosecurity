# Copy to .env and fill in. .env is gitignored.

# Claude API key for agent rationales/directives. Leave blank to use the template fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Ports used by ./dev.sh
BACKEND_PORT=8000
FRONTEND_PORT=5173

# SQLite database file (created at runtime)
DB_PATH=backend/biosecurity.sqlite3

# Simulation
SIM_SEED=42
SIM_START_DATE=2026-09-01
CLOCK_SECONDS_PER_DAY=2.0
